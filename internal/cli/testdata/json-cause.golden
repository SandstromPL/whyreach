  "findings": [
    {
      "rule_id": "WR002",
      "title": "api listens only on 127.0.0.1:8080 inside its container",
      "layer": 5,
      "confidence": "high",
      "explanation": "api's only listener for port 8080 is 127.0.0.1:8080 (in api). A socket bound to loopback accepts connections only from inside api's own network namespace, so worker can't reach it.",
      "supporting": [
        "ev-03",
        "ev-04",
        "ev-06"
      ],
      "fix": "Make the server in api listen on 0.0.0.0:8080 (or [::]:8080), for example with --host 0.0.0.0 or a HOST=0.0.0.0 setting, then restart api.",
      "doc_url": "docs/rules/WR002.md"
    }
  ],
  "facts": [
    {
      "text": "worker and api share network shop_default",
      "evidence": [
        "ev-02",
        "ev-03"
      ]
    },
    {
      "text": "\"api\" → 172.22.0.3 via 127.0.0.11:53, in worker",
      "evidence": [
        "ev-05"
      ]
    },
    {
      "text": "connect 172.22.0.3:8080 from worker: refused, ECONNREFUSED (0.1 ms)",
      "evidence": [
